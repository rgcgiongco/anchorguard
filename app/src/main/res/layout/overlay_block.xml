<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2132121"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/blocked_app_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/blocked_app_icon"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/blocked_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_blocked_title"
            android:textColor="#132121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blocked_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_blocked_app_default"
            android:textColor="#5C7373"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/blocked_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#0F6B6B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/blocked_unlock_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0F6B6B"
            android:text="@string/overlay_unlock_parent"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
