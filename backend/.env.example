# Database (Docker Compose defaults)
POSTGRES_DB=anchorguard
POSTGRES_USER=anchorguard
POSTGRES_PASSWORD=change-me

# Alternative explicit API datasource settings (override compose defaults when needed)
ANCHORGUARD_DB_URL=jdbc:postgresql://db:5432/anchorguard
ANCHORGUARD_DB_USER=anchorguard
ANCHORGUARD_DB_PASSWORD=change-me

# API security/config
ANCHORGUARD_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ANCHORGUARD_CORS_ORIGINS=https://app.anchorguard.com
ANCHORGUARD_API_BASE_URL=https://api.anchorguard.com/v1
